<?xml version="1.0"?>
<rdf:RDF xmlns="http://rdf.geohistoricaldata.org/def/cadastre#"
     xml:base="http://rdf.geohistoricaldata.org/def/cadastre"
     xmlns:ns="http://creativecommons.org/ns#"
     xmlns:org="http://www.w3.org/ns/org#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:time="http://www.w3.org/2006/time#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:cadastre="http://rdf.geohistoricaldata.org/def/cadastre#">
    <owl:Ontology rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#">
        <ns:license rdf:resource="http://creativecommons.org/licenses/by/2.0/"/>
        <ns:license rdf:resource="http://opendatacommons.org/licenses/by/"/>
        <ns:license rdf:resource="http://www.data.gouv.fr/Licence-Ouverte-Open-Licence"/>
        <terms:creator rdf:nodeID="genid1"/>
        <terms:description xml:lang="fr">Extension de l&apos;ontologie PeGaZus pour décrire les informations sur les parcelles, et les entités liées, présentes dans le cadastre ancien.</terms:description>
        <terms:description xml:lang="en">Extension of the PeGaZus ontology to describe the information about land plots and associated entities evocated in the land registry documents.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-01-24</terms:issued>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-07-12</terms:modified>
        <terms:publisher rdf:resource="http://fr.dbpedia.org/resource/Institut_national_de_l%27information_g%C3%A9ographique_et_foresti%C3%A8re"/>
        <terms:rights>Copyright 2024, IGN</terms:rights>
        <terms:title xml:lang="fr">Ontologie PeGaZus, extension dédiée à la représentation des parcelles cadastrales</terms:title>
        <terms:title xml:lang="en">Ontology PeGaZus, extension related to the French 19th-century Land Registry</terms:title>
        <vann:preferredNamespacePrefix>cad</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#"/>
        <owl:versionInfo>Version 0.1 - 2024-07-12</owl:versionInfo>
    </owl:Ontology>
    <rdf:Description rdf:nodeID="genid1">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <org:hasMembership rdf:nodeID="genid2"/>
        <foaf:family_name>Tual</foaf:family_name>
        <foaf:firstName>Solenn</foaf:firstName>
        <foaf:mbox rdf:resource="mailto:solenntual.pro@gmail.com"/>
        <foaf:name>Solenn Tual</foaf:name>
        <foaf:workInfoHomepage rdf:resource="https://www.umr-lastig.fr/solenn-tual/"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid2">
        <rdf:type rdf:resource="http://www.w3.org/ns/org#Membership"/>
        <org:memberDuring rdf:nodeID="genid3"/>
        <org:organization rdf:resource="http://www.ign.fr/"/>
        <org:organization rdf:resource="http://www.umr-lastig.fr/"/>
        <org:role rdf:nodeID="genid5"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid3">
        <rdf:type rdf:resource="http://www.w3.org/2006/time#Interval"/>
        <time:hasBeginning rdf:nodeID="genid4"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid5">
        <rdf:type rdf:resource="http://www.w3.org/ns/org#Role"/>
        <rdfs:label xml:lang="en">PhD</rdfs:label>
        <rdfs:label xml:lang="fr">PhD</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid4">
        <rdf:type rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <time:inXSDDateTimeStamp rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2024-05-21</time:inXSDDateTimeStamp>
    </rdf:Description>
    



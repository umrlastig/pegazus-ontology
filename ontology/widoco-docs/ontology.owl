    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#EventType">
        <rdfs:comment xml:lang="fr">Type d&apos;évènement. La classe addr:Event est décrite dans l&apos;ontologie PeGaZus.</rdfs:comment>
        <rdfs:comment xml:lang="en">Type of event. The class addr:Event is described in the PeGaZus ontology.</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#MLClasse">
        <rdfs:comment xml:lang="en">Class of a document. It differs from a source as it is the result of an assignment by a user. They are the result of a manual or automatic assignment process.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Classe d&apos;un document. Diffère d&apos;une source car relève d&apos;une attribution (manuelle ou automatique) par un utilisateur.</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#NamedEntity">
        <rdfs:comment xml:lang="fr">Entité nommée mentionnée dans une source, identifiée par un processus manuel ou automatique.</rdfs:comment>
        <rdfs:comment xml:lang="en">Named entity mentioned in a source, identified by a manual or automatic process.</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#Nature">
        <rdfs:comment xml:lang="fr">Nature de parcelle, correspond à une occupation ou un usage du sol.</rdfs:comment>
        <rdfs:comment xml:lang="en">Nature de parcelle, corresponds to a land use or occupation.</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#Source">
        <rdfs:comment xml:lang="fr">Type d&apos;une source à l&apos;origine d&apos;une information.</rdfs:comment>
        <rdfs:comment xml:lang="en">Type of a source at the origin of a piece of information.</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#SpecialCellValue">
        <rdfs:comment xml:lang="en">Special value related to the operation of cadastral documents, for example the mentions of construction, destruction, modifications of buildings indicated in the columns intended for folio numbers.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Valeur spéciale liée au fonctionnement des documents cadastraux, par exemple les mentions de construction, destruction, augmentation de bâtiments indiquées dans les colonnes destinées aux numéros de folio.</rdfs:comment>
        <skos:prefLabel xml:lang="en">Special cell value</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Valeur spéciale</skos:prefLabel>
    </rdf:Description>
    <rdf:Description rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#Taxpayer">
        <rdfs:comment xml:lang="en">Owner or usufructuary: person liable for property tax for land for which they have full ownership or usufruct.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Propriétaire ou usufruitier : personne redevable de l&apos;impôt foncier pour les terres dont elle a la pleine propriété ou l&apos;usufruit.</rdfs:comment>
        <skos:altLabel xml:lang="en">Owner</skos:altLabel>
        <skos:altLabel xml:lang="fr">Propriétaire ou usufruitier</skos:altLabel>
    </rdf:Description>
    <rdf:Description rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#URL">
        <rdfs:comment>Correspond à l&apos;URL de la source (image, base de donnée)</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#coordinatesInImageSystem">
        <rdfs:comment>Coordonnées (référentiel image) d&apos;une zone annotée (manuellement ou automatiquement) dans un document numérisé.</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#fromSource">
        <rdfs:comment xml:lang="fr">Déprécié depuis 03/2025. Un élément est affirmé dans une source.</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#hasAlternativeNumFolio">
        <rdfs:comment xml:lang="en">Alternative folio number (e.g. former number)</rdfs:comment>
        <rdfs:comment xml:lang="fr">Numéro de folio alternatif (ex: ancien numéro)</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#hasClasse">
        <rdfs:comment xml:lang="en">Indicates that a document or a document area has at least one class assigned manually or automatically.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Indique qu&apos;un document ou d&apos;une zone de document possède au moins une classe attribuée manuellement ou automatique.</rdfs:comment>

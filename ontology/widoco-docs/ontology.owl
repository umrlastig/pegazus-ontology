    <!-- http://rdf.geohistoricaldata.org/def/cadastre#fromSource -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#fromSource">
        <owl:equivalentProperty rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#sourcedFrom"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.geohistoricaldata.org/def/cadastre#hasClasse -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#hasClasse">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#Class"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.geohistoricaldata.org/def/cadastre#hasClasseValue -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#hasClasseValue">
        <rdfs:domain rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#Class"/>
        <rdfs:range rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#MLClasse"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.geohistoricaldata.org/def/cadastre#hasEquivalentFolio -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#hasEquivalentFolio">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.ica.org/standards/RiC/ontology#Instantiation"/>
                    <rdf:Description rdf:about="https://www.ica.org/standards/RiC/ontology#RecordResource"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.ica.org/standards/RiC/ontology#Instantiation"/>
                    <rdf:Description rdf:about="https://www.ica.org/standards/RiC/ontology#RecordResource"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://rdf.geohistoricaldata.org/def/cadastre#hasNamedEntity -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#hasNamedEntity">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#NamedEntity"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.geohistoricaldata.org/def/cadastre#hasPlotAddress -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#hasPlotAddress">
        <rdfs:domain rdf:resource="http://rdf.geohistoricaldata.org/def/address#AttributeVersion"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.geohistoricaldata.org/def/address#Address"/>
                    <rdf:Description rdf:about="http://rdf.geohistoricaldata.org/def/address#LandmarkRelation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://rdf.geohistoricaldata.org/def/cadastre#hasPlotNature -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#hasPlotNature">
        <owl:inverseOf rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#isPlotNatureOf"/>
        <rdfs:domain rdf:resource="http://rdf.geohistoricaldata.org/def/address#AttributeVersion"/>
        <rdfs:range rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#Nature"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.geohistoricaldata.org/def/cadastre#hasTaxpayer -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#hasTaxpayer">
        <rdfs:domain rdf:resource="http://rdf.geohistoricaldata.org/def/address#AttributeVersion"/>
        <rdfs:range rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#Taxpayer"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.geohistoricaldata.org/def/cadastre#isClasseOf -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#isClasseOf">
        <owl:inverseOf rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#hasClasse"/>
        <rdfs:domain rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#Class"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.geohistoricaldata.org/def/cadastre#isClasseValueOf -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#isClasseValueOf">
        <owl:inverseOf rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#hasClasseValue"/>
        <rdfs:domain rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#MLClasse"/>
        <rdfs:range rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#Class"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.geohistoricaldata.org/def/cadastre#isEventType -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#isEventType">
        <rdfs:domain rdf:resource="http://rdf.geohistoricaldata.org/def/address#Event"/>
        <rdfs:range rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#EventType"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.geohistoricaldata.org/def/cadastre#isMentionnedIn -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#isMentionnedIn">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.ica.org/standards/RiC/ontology#Instantiation"/>
                    <rdf:Description rdf:about="https://www.ica.org/standards/RiC/ontology#RecordResource"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://rdf.geohistoricaldata.org/def/cadastre#isNamedEntityType -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#isNamedEntityType">
        <rdfs:domain rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#NamedEntity"/>
        <rdfs:range rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#MLClasse"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.geohistoricaldata.org/def/cadastre#isPlotAddressOf -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#isPlotAddressOf">
        <owl:inverseOf rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#hasPlotAddress"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.geohistoricaldata.org/def/address#Address"/>
                    <rdf:Description rdf:about="http://rdf.geohistoricaldata.org/def/address#LandmarkRelation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://rdf.geohistoricaldata.org/def/address#AttributeVersion"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.geohistoricaldata.org/def/cadastre#isPlotNatureOf -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#isPlotNatureOf">
        <rdfs:domain rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#Nature"/>
        <rdfs:range rdf:resource="http://rdf.geohistoricaldata.org/def/address#AttributeVersion"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.geohistoricaldata.org/def/cadastre#isSourceOf -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#isSourceOf">
        <owl:inverseOf rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#fromSource"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.geohistoricaldata.org/def/cadastre#isSourceType -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#isSourceType">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.ica.org/standards/RiC/ontology#Instantiation"/>
                    <rdf:Description rdf:about="https://www.ica.org/standards/RiC/ontology#RecordResource"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#Source"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.geohistoricaldata.org/def/cadastre#isTaxpayerOf -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#isTaxpayerOf">
        <owl:inverseOf rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#hasTaxpayer"/>
        <rdfs:domain rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#Taxpayer"/>
        <rdfs:range rdf:resource="http://rdf.geohistoricaldata.org/def/address#AttributeVersion"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.geohistoricaldata.org/def/cadastre#mentions -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#mentions">
        <owl:inverseOf rdf:resource="http://rdf.geohistoricaldata.org/def/cadastre#isMentionnedIn"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.ica.org/standards/RiC/ontology#Instantiation"/>
                    <rdf:Description rdf:about="https://www.ica.org/standards/RiC/ontology#RecordResource"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.geohistoricaldata.org/def/cadastre#passedTo -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#passedTo">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#SpecialCellValue"/>
                    <rdf:Description rdf:about="https://www.ica.org/standards/RiC/ontology#Instantiation"/>
                    <rdf:Description rdf:about="https://www.ica.org/standards/RiC/ontology#RecordResource"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://rdf.geohistoricaldata.org/def/cadastre#sourcedFrom -->


    <owl:ObjectProperty rdf:about="http://rdf.geohistoricaldata.org/def/cadastre#sourcedFrom">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>

@prefix : <http://rdf.geohistoricaldata.org/def/cadastre#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://rdf.geohistoricaldata.org/def/cadastre#> .

<http://rdf.geohistoricaldata.org/def/cadastre#> rdf:type owl:Ontology ;
                                                  <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by/2.0/> ,
                                                                                          <http://opendatacommons.org/licenses/by/> ,
                                                                                          <http://www.data.gouv.fr/Licence-Ouverte-Open-Licence> ;
                                                  <http://purl.org/dc/terms/creator> _:genid1 ;
                                                  <http://purl.org/dc/terms/description> "Extension de l'ontologie PeGaZus pour décrire les informations sur les parcelles, et les entités liées, présentes dans le cadastre ancien."@fr ,
                                                                                         "Extension of the PeGaZus ontology to describe the information about land plots and associated entities evocated in the land registry documents."@en ;
                                                  <http://purl.org/dc/terms/issued> "2024-01-24"^^xsd:date ;
                                                  <http://purl.org/dc/terms/modified> "2024-07-12"^^xsd:date ;
                                                  <http://purl.org/dc/terms/publisher> <http://fr.dbpedia.org/resource/Institut_national_de_l%27information_g%C3%A9ographique_et_foresti%C3%A8re> ;
                                                  <http://purl.org/dc/terms/rights> "Copyright 2024, IGN" ;
                                                  <http://purl.org/dc/terms/title> "Ontologie PeGaZus, extension dédiée à la représentation des parcelles cadastrales"@fr ,
                                                                                   "Ontology PeGaZus, extension related to the French 19th-century Land Registry"@en ;
                                                  <http://purl.org/vocab/vann/preferredNamespacePrefix> "cad" ;
                                                  <http://purl.org/vocab/vann/preferredNamespaceUri> <http://rdf.geohistoricaldata.org/def/cadastre#> ;
                                                  owl:versionInfo "Version 0.1 - 2024-07-12" .

_:genid1 rdf:type <http://xmlns.com/foaf/0.1/Person> ;
          <http://www.w3.org/ns/org#hasMembership> _:genid2 ;
          <http://xmlns.com/foaf/0.1/family_name> "Tual" ;
          <http://xmlns.com/foaf/0.1/firstName> "Solenn" ;
          <http://xmlns.com/foaf/0.1/mbox> <mailto:solenntual.pro@gmail.com> ;
          <http://xmlns.com/foaf/0.1/name> "Solenn Tual" ;
          <http://xmlns.com/foaf/0.1/workInfoHomepage> <https://www.umr-lastig.fr/solenn-tual/> .

_:genid2 rdf:type <http://www.w3.org/ns/org#Membership> ;
          <http://www.w3.org/ns/org#memberDuring> _:genid3 ;
          <http://www.w3.org/ns/org#organization> <http://www.ign.fr/> ,
                                                  <http://www.umr-lastig.fr/> ;
          <http://www.w3.org/ns/org#role> _:genid5 .

_:genid3 rdf:type <http://www.w3.org/2006/time#Interval> ;
          <http://www.w3.org/2006/time#hasBeginning> _:genid4 .

_:genid5 rdf:type <http://www.w3.org/ns/org#Role> ;
          rdfs:label "PhD"@en ,
                     "PhD"@fr .

_:genid4 rdf:type <http://www.w3.org/2006/time#Instant> ;
          <http://www.w3.org/2006/time#inXSDDateTimeStamp> "2024-05-21"^^xsd:dateTimeStamp .


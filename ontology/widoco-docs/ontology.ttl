#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://rdf.geohistoricaldata.org/def/cadastre#fromSource
:fromSource rdf:type owl:ObjectProperty ;
            owl:equivalentProperty :sourcedFrom ;
            rdfs:domain owl:Thing ;
            rdfs:range owl:Thing .


###  http://rdf.geohistoricaldata.org/def/cadastre#hasClasse
:hasClasse rdf:type owl:ObjectProperty ;
           rdfs:domain owl:Thing ;
           rdfs:range :Class .


###  http://rdf.geohistoricaldata.org/def/cadastre#hasClasseValue
:hasClasseValue rdf:type owl:ObjectProperty ;
                rdfs:domain :Class ;
                rdfs:range :MLClasse .


###  http://rdf.geohistoricaldata.org/def/cadastre#hasEquivalentFolio
:hasEquivalentFolio rdf:type owl:ObjectProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( <https://www.ica.org/standards/RiC/ontology#Instantiation>
                                                <https://www.ica.org/standards/RiC/ontology#RecordResource>
                                              )
                                ] ;
                    rdfs:range [ rdf:type owl:Class ;
                                 owl:unionOf ( <https://www.ica.org/standards/RiC/ontology#Instantiation>
                                               <https://www.ica.org/standards/RiC/ontology#RecordResource>
                                             )
                               ] .


###  http://rdf.geohistoricaldata.org/def/cadastre#hasNamedEntity
:hasNamedEntity rdf:type owl:ObjectProperty ;
                rdfs:domain owl:Thing ;
                rdfs:range :NamedEntity .


###  http://rdf.geohistoricaldata.org/def/cadastre#hasPlotAddress
:hasPlotAddress rdf:type owl:ObjectProperty ;
                rdfs:domain <http://rdf.geohistoricaldata.org/def/address#AttributeVersion> ;
                rdfs:range [ rdf:type owl:Class ;
                             owl:unionOf ( <http://rdf.geohistoricaldata.org/def/address#Address>
                                           <http://rdf.geohistoricaldata.org/def/address#LandmarkRelation>
                                         )
                           ] .


###  http://rdf.geohistoricaldata.org/def/cadastre#hasPlotNature
:hasPlotNature rdf:type owl:ObjectProperty ;
               owl:inverseOf :isPlotNatureOf ;
               rdfs:domain <http://rdf.geohistoricaldata.org/def/address#AttributeVersion> ;
               rdfs:range :Nature .


###  http://rdf.geohistoricaldata.org/def/cadastre#hasTaxpayer
:hasTaxpayer rdf:type owl:ObjectProperty ;
             rdfs:domain <http://rdf.geohistoricaldata.org/def/address#AttributeVersion> ;
             rdfs:range :Taxpayer .


###  http://rdf.geohistoricaldata.org/def/cadastre#isClasseOf
:isClasseOf rdf:type owl:ObjectProperty ;
            owl:inverseOf :hasClasse ;
            rdfs:domain :Class ;
            rdfs:range owl:Thing .


###  http://rdf.geohistoricaldata.org/def/cadastre#isClasseValueOf
:isClasseValueOf rdf:type owl:ObjectProperty ;
                 owl:inverseOf :hasClasseValue ;
                 rdfs:domain :MLClasse ;
                 rdfs:range :Class .


###  http://rdf.geohistoricaldata.org/def/cadastre#isEventType
:isEventType rdf:type owl:ObjectProperty ;
             rdfs:domain <http://rdf.geohistoricaldata.org/def/address#Event> ;
             rdfs:range :EventType .


###  http://rdf.geohistoricaldata.org/def/cadastre#isMentionnedIn
:isMentionnedIn rdf:type owl:ObjectProperty ;
                rdfs:domain owl:Thing ;
                rdfs:range [ rdf:type owl:Class ;
                             owl:unionOf ( <https://www.ica.org/standards/RiC/ontology#Instantiation>
                                           <https://www.ica.org/standards/RiC/ontology#RecordResource>
                                         )
                           ] .


###  http://rdf.geohistoricaldata.org/def/cadastre#isNamedEntityType
:isNamedEntityType rdf:type owl:ObjectProperty ;
                   rdfs:domain :NamedEntity ;
                   rdfs:range :MLClasse .


###  http://rdf.geohistoricaldata.org/def/cadastre#isPlotAddressOf
:isPlotAddressOf rdf:type owl:ObjectProperty ;
                 owl:inverseOf :hasPlotAddress ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( <http://rdf.geohistoricaldata.org/def/address#Address>
                                             <http://rdf.geohistoricaldata.org/def/address#LandmarkRelation>
                                           )
                             ] ;
                 rdfs:range <http://rdf.geohistoricaldata.org/def/address#AttributeVersion> .


###  http://rdf.geohistoricaldata.org/def/cadastre#isPlotNatureOf
:isPlotNatureOf rdf:type owl:ObjectProperty ;
                rdfs:domain :Nature ;
                rdfs:range <http://rdf.geohistoricaldata.org/def/address#AttributeVersion> .


###  http://rdf.geohistoricaldata.org/def/cadastre#isSourceOf
:isSourceOf rdf:type owl:ObjectProperty ;
            owl:inverseOf :fromSource ;
            rdfs:domain owl:Thing ;
            rdfs:range owl:Thing .


###  http://rdf.geohistoricaldata.org/def/cadastre#isSourceType
:isSourceType rdf:type owl:ObjectProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( <https://www.ica.org/standards/RiC/ontology#Instantiation>
                                          <https://www.ica.org/standards/RiC/ontology#RecordResource>
                                        )
                          ] ;
              rdfs:range :Source .


###  http://rdf.geohistoricaldata.org/def/cadastre#isTaxpayerOf
:isTaxpayerOf rdf:type owl:ObjectProperty ;
              owl:inverseOf :hasTaxpayer ;
              rdfs:domain :Taxpayer ;
              rdfs:range <http://rdf.geohistoricaldata.org/def/address#AttributeVersion> .


###  http://rdf.geohistoricaldata.org/def/cadastre#mentions
:mentions rdf:type owl:ObjectProperty ;
          owl:inverseOf :isMentionnedIn ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( <https://www.ica.org/standards/RiC/ontology#Instantiation>
                                      <https://www.ica.org/standards/RiC/ontology#RecordResource>
                                    )
                      ] ;
          rdfs:range owl:Thing .


###  http://rdf.geohistoricaldata.org/def/cadastre#passedTo
:passedTo rdf:type owl:ObjectProperty ;
          rdfs:domain owl:Thing ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( :SpecialCellValue
                                     <https://www.ica.org/standards/RiC/ontology#Instantiation>
                                     <https://www.ica.org/standards/RiC/ontology#RecordResource>
                                   )
                     ] .


###  http://rdf.geohistoricaldata.org/def/cadastre#sourcedFrom
:sourcedFrom rdf:type owl:ObjectProperty ;
             rdfs:domain owl:Thing ;
             rdfs:range owl:Thing .


###  http://rdf.geohistoricaldata.org/def/cadastre#takenFrom
:takenFrom rdf:type owl:ObjectProperty ;
           rdfs:domain owl:Thing ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :SpecialCellValue
                                      <https://www.ica.org/standards/RiC/ontology#Instantiation>
                                      <https://www.ica.org/standards/RiC/ontology#RecordResource>
                                    )
                      ] .


###  http://www.w3.org/ns/prov#used
<http://www.w3.org/ns/prov#used> rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#wasAssociatedWith
<http://www.w3.org/ns/prov#wasAssociatedWith> rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#wasGeneratedBy
<http://www.w3.org/ns/prov#wasGeneratedBy> rdf:type owl:ObjectProperty .


###  https://www.ica.org/standards/RiC/ontology#hasComponentTransitive
<https://www.ica.org/standards/RiC/ontology#hasComponentTransitive> rdf:type owl:ObjectProperty .


###  https://www.ica.org/standards/RiC/ontology#hasConstituentTransitive
<https://www.ica.org/standards/RiC/ontology#hasConstituentTransitive> rdf:type owl:ObjectProperty .


###  https://www.ica.org/standards/RiC/ontology#hasCreationDate
<https://www.ica.org/standards/RiC/ontology#hasCreationDate> rdf:type owl:ObjectProperty .


###  https://www.ica.org/standards/RiC/ontology#hasOrHadComponent
<https://www.ica.org/standards/RiC/ontology#hasOrHadComponent> rdf:type owl:ObjectProperty .


###  https://www.ica.org/standards/RiC/ontology#hasOrHadConstituent
<https://www.ica.org/standards/RiC/ontology#hasOrHadConstituent> rdf:type owl:ObjectProperty .


###  https://www.ica.org/standards/RiC/ontology#hasOrHadDigitalInstantiation
<https://www.ica.org/standards/RiC/ontology#hasOrHadDigitalInstantiation> rdf:type owl:ObjectProperty .


###  https://www.ica.org/standards/RiC/ontology#hasOrHadInstantiation
<https://www.ica.org/standards/RiC/ontology#hasOrHadInstantiation> rdf:type owl:ObjectProperty .


###  https://www.ica.org/standards/RiC/ontology#includesOrIncluded
<https://www.ica.org/standards/RiC/ontology#includesOrIncluded> rdf:type owl:ObjectProperty .


###  https://www.ica.org/standards/RiC/ontology#isCreationDateOf
<https://www.ica.org/standards/RiC/ontology#isCreationDateOf> rdf:type owl:ObjectProperty .


###  https://www.ica.org/standards/RiC/ontology#isOrWasComponentOf
<https://www.ica.org/standards/RiC/ontology#isOrWasComponentOf> rdf:type owl:ObjectProperty .


###  https://www.ica.org/standards/RiC/ontology#isOrWasConstituentOf
<https://www.ica.org/standards/RiC/ontology#isOrWasConstituentOf> rdf:type owl:ObjectProperty .


###  https://www.ica.org/standards/RiC/ontology#isOrWasDigitalInstantiationOf
<https://www.ica.org/standards/RiC/ontology#isOrWasDigitalInstantiationOf> rdf:type owl:ObjectProperty .


###  https://www.ica.org/standards/RiC/ontology#isOrWasIncludedIn
<https://www.ica.org/standards/RiC/ontology#isOrWasIncludedIn> rdf:type owl:ObjectProperty .


###  https://www.ica.org/standards/RiC/ontology#isOrWasInstantiationOf
<https://www.ica.org/standards/RiC/ontology#isOrWasInstantiationOf> rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/terms/identifier
<http://purl.org/dc/terms/identifier> rdf:type owl:DatatypeProperty .


###  http://rdf.geohistoricaldata.org/def/cadastre#URL
:URL rdf:type owl:DatatypeProperty ;
     rdfs:domain owl:Thing ;
     rdfs:range rdfs:Literal .


###  http://rdf.geohistoricaldata.org/def/cadastre#coordinatesInImageSystem
:coordinatesInImageSystem rdf:type owl:DatatypeProperty ;
                          rdfs:domain <https://www.ica.org/standards/RiC/ontology#Instantiation> ;
                          rdfs:range rdfs:Literal .


###  http://rdf.geohistoricaldata.org/def/cadastre#hasAlternativeNumFolio
:hasAlternativeNumFolio rdf:type owl:DatatypeProperty ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( <https://www.ica.org/standards/RiC/ontology#Instantiation>
                                                    <https://www.ica.org/standards/RiC/ontology#RecordResource>
                                                  )
                                    ] ;
                        rdfs:range xsd:string .


###  http://rdf.geohistoricaldata.org/def/cadastre#hasNumFolio
:hasNumFolio rdf:type owl:DatatypeProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( <https://www.ica.org/standards/RiC/ontology#Instantiation>
                                         <https://www.ica.org/standards/RiC/ontology#RecordResource>
                                       )
                         ] ;
             rdfs:range xsd:string .


###  http://rdf.geohistoricaldata.org/def/cadastre#lineOrderInArea
:lineOrderInArea rdf:type owl:DatatypeProperty ;
                 rdfs:domain <https://www.ica.org/standards/RiC/ontology#Instantiation> ;
                 rdfs:range xsd:integer .


###  http://rdf.geohistoricaldata.org/def/cadastre#taxpayerActivity
:taxpayerActivity rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Taxpayer ;
                  rdfs:range xsd:string .


###  http://rdf.geohistoricaldata.org/def/cadastre#taxpayerAddress
:taxpayerAddress rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Taxpayer ;
                 rdfs:range xsd:string .


###  http://rdf.geohistoricaldata.org/def/cadastre#taxpayerFamilyStatus
:taxpayerFamilyStatus rdf:type owl:DatatypeProperty ;
                      owl:equivalentProperty :taxpayerStatus ;
                      rdfs:domain :Taxpayer ;
                      rdfs:range xsd:string .


###  http://rdf.geohistoricaldata.org/def/cadastre#taxpayerFirstName
:taxpayerFirstName rdf:type owl:DatatypeProperty ;
                   owl:equivalentProperty :taxpayerFirstNames ;
                   rdfs:domain :Taxpayer ;
                   rdfs:range xsd:string .


###  http://rdf.geohistoricaldata.org/def/cadastre#taxpayerFirstNames
:taxpayerFirstNames rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Taxpayer ;
                    rdfs:range xsd:string .


###  http://rdf.geohistoricaldata.org/def/cadastre#taxpayerLabel
:taxpayerLabel rdf:type owl:DatatypeProperty ;
               rdfs:domain :Taxpayer ;
               rdfs:range xsd:string .


###  http://rdf.geohistoricaldata.org/def/cadastre#taxpayerStatus
:taxpayerStatus rdf:type owl:DatatypeProperty ;
                rdfs:domain :Taxpayer ;
                rdfs:range xsd:string .


###  http://rdf.geohistoricaldata.org/def/cadastre#taxpayerTitle
:taxpayerTitle rdf:type owl:DatatypeProperty ;
               rdfs:domain :Taxpayer ;
               rdfs:range xsd:string .


###  http://rdf.geohistoricaldata.org/def/cadastre#transcription
:transcription rdf:type owl:DatatypeProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :NamedEntity
                                           <https://www.ica.org/standards/RiC/ontology#Instantiation>
                                         )
                           ] ;
               rdfs:range rdfs:Literal .


###  http://rdf.insee.fr/def/geo#codeINSEE
<http://rdf.insee.fr/def/geo#codeINSEE> rdf:type owl:DatatypeProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:DatatypeProperty .


###  https://www.ica.org/standards/RiC/ontology#identifier
<https://www.ica.org/standards/RiC/ontology#identifier> rdf:type owl:DatatypeProperty .


###  https://www.ica.org/standards/RiC/ontology#name
<https://www.ica.org/standards/RiC/ontology#name> rdf:type owl:DatatypeProperty .


###  https://www.wikidata.org/wiki/Property:P8422
<https://www.wikidata.org/wiki/Property:P8422> rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://purl.org/vocommons/voaf#Vocabulary
<http://purl.org/vocommons/voaf#Vocabulary> rdf:type owl:Class .


###  http://rdf.geohistoricaldata.org/def/address#Address
<http://rdf.geohistoricaldata.org/def/address#Address> rdf:type owl:Class .


